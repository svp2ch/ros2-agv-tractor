<?xml version="1.0"?>
<!--
  Мир Gazebo Classic: плоское сельскохозяйственное поле.
  Намеренно минималистичный для экономии RAM и CPU в VM:
    - нет тяжёлых мешей и текстур
    - 4 препятствия-столба
    - упрощённые настройки физики ODE
-->
<sdf version="1.6">
  <world name="agricultural_field">

    <!-- ====== Географическая точка отсчёта (для GPS) ======
         Без этого блока Gazebo помещает начало координат GPS в (0,0) —
         на стык UTM-зон и полушарий, где малейший шум GPS перебрасывает
         датум navsat_transform между зонами (координаты прыгают на сотни км),
         и слияние GPS в ekf_global разваливается.
         Задаём реальное с/х поле: Краснодарский край (UTM зона 37N,
         вдали от границ зон) — GPS-координаты стабильны, датум фиксируется. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>45.040000</latitude_deg>
      <longitude_deg>38.980000</longitude_deg>
      <elevation>30.0</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- ====== Физика (ODE) ====== -->
    <physics type="ode">
      <!-- 1000 шагов/с = достаточная точность для с/х задач -->
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <ode>
        <solver>
          <type>quick</type>
          <iters>50</iters>
          <sor>1.3</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.001</contact_surface_layer>
        </constraints>
      </ode>
    </physics>

    <!-- ====== Освещение: солнце ====== -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- ====== Земля: плоская поверхность ====== -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- ====== Препятствие 1: столб (дерево/межевой знак) ====== -->
    <model name="obstacle_1">
      <static>true</static>
      <pose>5.0 3.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.1</radius><length>2.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>2.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.0 1</ambient>
            <diffuse>0.4 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Препятствие 2 ====== -->
    <model name="obstacle_2">
      <static>true</static>
      <pose>-4.0 5.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.1</radius><length>2.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>2.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.0 1</ambient>
            <diffuse>0.4 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Препятствие 3 ====== -->
    <model name="obstacle_3">
      <static>true</static>
      <pose>8.0 -4.0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.1</radius><length>2.5</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.1</radius><length>2.5</length></cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.2 0.0 1</ambient>
            <diffuse>0.4 0.2 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Препятствие 4: столб оборудования (0.5x0.5, высота 2.2м) ======
         Высота > плоскости скана лидара (1.8м), иначе 2D-лидар не увидит. -->
    <model name="obstacle_4">
      <static>true</static>
      <pose>-6.0 -3.0 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.5 0.5 2.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.5 0.5 2.2</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.0 1</ambient>
            <diffuse>0.6 0.6 0.0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Препятствие 5: красная колонна 1x1, высота 2.2м, на пути трактора ====== -->
    <model name="obstacle_5">
      <static>true</static>
      <pose>8 -13 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 1 2.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 1 2.2</size></box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Препятствие 6: синяя колонна 1x1, высота 2.2м ====== -->
    <model name="obstacle_6">
      <static>true</static>
      <pose>-5 -5 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 1 2.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 1 2.2</size></box>
          </geometry>
          <material>
            <ambient>0 0 1 1</ambient>
            <diffuse>0 0 1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Препятствие 7: зелёная колонна 1x1, высота 2.2м ====== -->
    <model name="obstacle_7">
      <static>true</static>
      <pose>12 3 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1 1 2.2</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1 1 2.2</size></box>
          </geometry>
          <material>
            <ambient>0 1 0 1</ambient>
            <diffuse>0 1 0 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ====== Настройки сцены (без теней для ускорения) ====== -->
    <scene>
      <ambient>0.6 0.6 0.6 1.0</ambient>
      <background>0.7 0.8 0.9 1.0</background>
      <shadows>false</shadows>
    </scene>

    <!-- ====== GUI отключён (headless режим) ====== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>-8 0 6 0 0.5 0</pose>
      </camera>
    </gui>

  </world>
</sdf>
